#!/bin/bash
set -e

[ -n "${GIECKO_CONFIG_DIR:-}" ] && [ -f "$GIECKO_CONFIG_DIR/giecko.env" ] && . "$GIECKO_CONFIG_DIR/giecko.env"
[ -f /etc/giecko.env ] && . /etc/giecko.env
[ -f "$HOME/.giecko.env" ] && . "$HOME/.giecko.env"

IN_SESSION=0
[ -n "${GIECKO_RUN_ID:-}" ] && IN_SESSION=1

CMD="${1:-help}"
shift || true

QUIET=0
[[ "${*:-}" == *--quiet* ]] && QUIET=1
say() { [ "$QUIET" = 1 ] || echo "$@"; }
has() { command -v "$1" >/dev/null 2>&1; }

cmd_help() {
  cat <<'HELP'
 giecko — your pocket toolkit

  On your LAPTOP (run inside your Giecko repo clone):
    giecko up [--stack ide|desktop] [--duration 180] [--password PW]
              [--packages "go hugo"] [--autosave 15] [--repo owner/repo] [--no-open]
        dispatch a new session, wait till it's live, open the run page
    giecko ls [--repo owner/repo]
        recent sessions + save branches
    giecko watch <run-id>
        wait for a session to go live (reads its published report)

  Inside a SESSION (on the runner):
    giecko info          run id, region, stack, workspace
    giecko urls          the browser URLs for this session
    giecko save          snapshot the workspace to branch giecko-saves/run-<id>
    giecko timeleft      minutes left before the runner stops
    giecko room [name]   switch to a named room (persistent tmux session)
    giecko rooms         list the rooms on this runner
    giecko persist       show how to opt in to a persistent home directory

  File transfer (in the session terminal):
    tsz <file>           download a file to your browser (progress bar!)
    trz                  upload from your browser (file picker / drag-drop)
    sz <file> / rz       ZMODEM fallback
HELP
}

cmd_info() {
  if [ "$IN_SESSION" = 0 ]; then echo "  not inside a session. Try: giecko ls"; return 0; fi
  echo " run:       ${GIECKO_RUN_ID:-?}"
  echo "   region:    ${GIECKO_REGION:-?}"
  echo "   stack:     ${GIECKO_STACK:-?}"
  echo "   user:      ${GIECKO_USER:-giecko}"
  echo "   workspace: ${GITHUB_WORKSPACE:-$PWD}"
}

cmd_urls() {
  if [ "$IN_SESSION" = 0 ]; then echo "  not inside a session. Try: giecko ls"; return 0; fi
  echo "  terminal: ${GIECKO_URL_TERM:-"(see the Actions run summary)"}"
  [ -n "${GIECKO_URL_CODE:-}" ] && echo " vscode:    $GIECKO_URL_CODE"
  [ -n "${GIECKO_URL_DESK:-}" ] && echo " desktop:   $GIECKO_URL_DESK"
}

cmd_save() {
  if [ "$IN_SESSION" = 0 ]; then say " giecko save only works inside a session (it would push a junk branch from here)"; exit 1; fi
  local repo br
  repo="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
  [ -n "$repo" ] && [ -d "$repo/.git" ] || { say " not inside a git repo, nothing to save"; exit 1; }
  br="$(git -C "$repo" branch --show-current 2>/dev/null || echo "")"
  [ -n "$br" ] || { say " detached HEAD, nothing to save"; exit 1; }
  git -C "$repo" config user.email >/dev/null 2>&1 || git -C "$repo" config user.email "giecko@local"
  git -C "$repo" config user.name >/dev/null 2>&1 || git -C "$repo" config user.name "${GIECKO_USER:-giecko}"
  git -C "$repo" add -A
  if git -C "$repo" diff --cached --quiet; then say " nothing new to save"; return 0; fi
  git -C "$repo" commit -qm " giecko save $(date -u '+%Y-%m-%d %H:%M UTC')" || { say " commit failed"; exit 1; }
  git -C "$repo" push -q -u origin "$br" 2>/dev/null || { say " push failed (no token or no permission?)"; exit 1; }
  say " saved  branch \`$br\`"
}

gh_flags() {
  GFLAGS=()
  [ -n "${REPO:-}" ] && GFLAGS=(-R "$REPO")
}

cmd_ls() {
  REPO=""
  while [ $# -gt 0 ]; do case "$1" in --repo) REPO="$2"; shift 2;; *) echo " unknown flag: $1"; return 1;; esac; done
  has gh || { echo " need the GitHub CLI: https://cli.github.com"; return 1; }
  gh_flags; gh run list "${GFLAGS[@]}" --workflow=giecko.yml -L 10 2>&1 || return 1
  echo ""
  echo " save branches (newest first):"
  git ls-remote origin 'refs/heads/giecko-saves/*' 2>/dev/null | awk '{print $2}' | sed 's|refs/heads/||' | sort -r | head -n 10 || echo "(git remote unavailable — run inside the repo clone)"
}

cmd_watch() {
  local id="${1:-}" pw="${2:-}"
  [ -n "$id" ] || { echo "usage: giecko watch <run-id>"; return 1; }
  has git || { echo " need git"; return 1; }
  git rev-parse --show-toplevel >/dev/null 2>&1 || { echo " run this inside your Giecko repo clone (needs the git remote)"; return 1; }
  echo " watching run $id (up to 6 min)..."
  local deadline=$((SECONDS + 360)) out term code region boot
  while [ "$SECONDS" -lt "$deadline" ]; do
    if git fetch -q origin giecko-reports 2>/dev/null \
       && out=$(git show "FETCH_HEAD:reports/run-$id.md" 2>/dev/null); then
      term=$(echo "$out" | grep -oE 'url_terminal: .*' | sed 's/url_terminal: //' | head -n 1 || echo "?")
      code=$(echo "$out" | grep -oE 'url_code: .*' | sed 's/url_code: //' | head -n 1 || echo "?")
      desk=$(echo "$out" | grep -oE 'url_desktop: .*' | sed 's/url_desktop: //' | head -n 1 || echo "?")
      region=$(echo "$out" | grep -oE 'region: [^,]+' | sed 's/region: //' || echo "?")
      boot=$(echo "$out" | grep -oE 'boot_seconds: [0-9]+' | awk '{print $2}' || echo "?")
      show_url() {
        case "$1" in
          "https://****"*) echo "(masked — scan the QR in the run logs)";;
          https://*) echo "$1";;
          YES*) echo "(live — grab the URL from the run summary)";;
          *) echo "(not in this session)";;
        esac
      }
      cat <<EOF

============================================================
   GIECKO IS LIVE!
============================================================
    terminal: $(show_url "$term")
   vscode:    $(show_url "$code")
   desktop:   $(show_url "$desk")
   region: $region    boot: ${boot}s
   password: ${pw:-"(the one you dispatched with)"}
============================================================
  run page: $(gh run view "$id" --json url -q .url 2>/dev/null || echo "(gh unavailable)")
============================================================
EOF
      if command -v qrencode >/dev/null 2>&1; then
        case "$term" in https://*) echo " terminal QR:"; qrencode -t UTF8 -m 1 "$term" || true;; esac
        case "$code" in https://*) echo " vscode QR:"; qrencode -t UTF8 -m 1 "$code" || true;; esac
        case "$desk" in https://*) echo " desktop QR:"; qrencode -t UTF8 -m 1 "$desk" || true;; esac
      fi
      return 0
    fi
    rs=$(gh run view "$id" --json status -q .status 2>/dev/null || echo "?")
    if [ "$rs" = "completed" ]; then
      echo " run $id ended without publishing a report — check it for failures."
      return 1
    fi
    if [ "$rs" = "?" ] && ! gh run view "$id" --json url >/dev/null 2>&1; then
      echo " run $id is unreachable (deleted?) — giving up."
      return 1
    fi
    sleep 10
  done
  echo "⏳ still not live after 6 min — check manually: $(gh run view "$id" --json url -q .url 2>/dev/null || echo "(gh unavailable)")"
  return 1
}

cmd_up() {
  local STACK="ide" DURATION="180" PASSWORD="" PACKAGES="" AUTOSAVE="15" OPEN="1" REPO=""
  while [ $# -gt 0 ]; do case "$1" in
    --stack) STACK="$2"; shift 2;;
    --duration) DURATION="$2"; shift 2;;
    --password) PASSWORD="$2"; shift 2;;
    --packages) PACKAGES="$2"; shift 2;;
    --autosave) AUTOSAVE="$2"; shift 2;;
    --repo) REPO="$2"; shift 2;;
    --no-open) OPEN=0; shift;;
    --open) OPEN=1; shift;;
    -h|--help) cmd_help; return 0;;
    *) echo " unknown flag: $1"; return 1;;
  esac; done
  has gh || { echo " need the GitHub CLI: https://cli.github.com"; return 1; }
  gh auth status >/dev/null 2>&1 || { echo " gh isn't logged in. Run: gh auth login"; return 1; }

  if [ -z "$PASSWORD" ]; then
    if [ -t 0 ]; then
      read -r -s -p " password (empty = generate a random one): " PASSWORD < /dev/tty 2>/dev/null || true
      echo ""
    fi
    if [ -z "$PASSWORD" ]; then
      PASSWORD=$(head -c 18 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 16)
      echo " generated password (save this!): $PASSWORD"
    fi
  fi

  local before id=""
  gh_flags; before=$(gh run list "${GFLAGS[@]}" --workflow=giecko.yml -L1 --json databaseId -q '.[0].databaseId' 2>/dev/null | grep -oE '[0-9]+' || echo "")
  echo " dispatching Giecko (stack=$STACK, ${DURATION}min, autosave=${AUTOSAVE}m)..."
  gh_flags
  if ! gh workflow run "${GFLAGS[@]}" giecko.yml \
      -f stack="$STACK" -f password="$PASSWORD" -f duration_minutes="$DURATION" \
      -f packages="$PACKAGES" -f autosave_minutes="$AUTOSAVE" 2>&1; then
    echo ""
    echo " dispatch failed. If it says 403 / forbidden, your token needs the workflow scope:"
    echo "   gh auth refresh -s workflow"
    return 1
  fi
  echo "⏳ waiting for the run to appear..."
  for _ in {1..12}; do
    gh_flags; id=$(gh run list "${GFLAGS[@]}" --workflow=giecko.yml -L1 --json databaseId -q '.[0].databaseId' 2>/dev/null | grep -oE '[0-9]+' || echo "")
    if [ -n "$id" ] && [ "$id" != "$before" ]; then break; fi
    sleep 5
  done
  [ -n "$id" ] && [ "$id" != "$before" ] || { echo " dispatched, but can't see the new run yet — check the Actions tab."; return 1; }
  echo " run id: $id"
  echo " password: $PASSWORD"
  if ! cmd_watch "$id" "$PASSWORD"; then return 1; fi
  if [ "$OPEN" = 1 ]; then
    echo " opening the run page (tunnel URLs are in the summary)..."
    gh_flags; gh run view "${GFLAGS[@]}" "$id" --web >/dev/null 2>&1 || echo "(couldn't open a browser — URL printed above)"
  fi
}

cmd_timeleft() {
  if [ -z "${GIECKO_END_EPOCH:-}" ]; then echo "  unknown (no end time recorded)"; return 0; fi
  local now left
  now=$(date +%s)
  left=$(( GIECKO_END_EPOCH - now ))
  if [ "$left" -le 0 ]; then echo "  time is up - final backup soon"; else echo "  $(( left / 60 )) minutes left"; fi
}

cmd_room() {
  local name="${1:-}"
  if ! has tmux; then echo "  tmux not installed, rooms unavailable"; return 1; fi
  if [ -z "$name" ]; then
    name="$(basename "$(tmux display-message -p '#S' 2>/dev/null || echo giecko)")"
    echo "  current room: $name"
    return 0
  fi
  case "$name" in *[!A-Za-z0-9_-]*) echo "  room name: letters, numbers, - and _ only"; return 1;; esac
  if [ -n "${TMUX:-}" ]; then
    tmux new -A -s "$name" -c "$PWD" && tmux switch-client -t "$name"
  else
    tmux new -A -s "$name" -c "$PWD"
  fi
}

cmd_rooms() {
  if ! has tmux; then echo "  tmux not installed, rooms unavailable"; return 1; fi
  local cur
  cur="$(basename "$(tmux display-message -p '#S' 2>/dev/null || echo '')")"
  tmux ls 2>/dev/null | while read -r line; do
    local s="${line%%:*}"
    if [ "$s" = "$cur" ]; then echo " * $line"; else echo "   $line"; fi
  done || echo "  no rooms yet - create one: giecko room project-x"
}

cmd_persist() {
  echo "  a persistent home keeps your dotfiles between sessions"
  echo "  opt in when launching: workflow input persist_home = true"
  echo "  inside the session your home is snapshotted to branch giecko-home"
}

case "$CMD" in
  info) cmd_info ;;
  urls) cmd_urls ;;
  save) cmd_save ;;
  timeleft) cmd_timeleft ;;
  room) cmd_room "$@" ;;
  rooms) cmd_rooms ;;
  persist) cmd_persist ;;
  up) cmd_up "$@" ;;
  ls) cmd_ls "$@" ;;
  watch) cmd_watch "$@" ;;
  *) cmd_help ;;
esac
